{{- $gui := (index .hosts .hostID).gui -}}
# Homebrew bundle — https://github.com/Homebrew/homebrew-bundle
#
# Rendered to ~/.Brewfile, so `brew bundle --global` works by hand as well as
# from the chezmoi script that provisions this.
#
# The old `tap "homebrew/bundle"` line is gone: bundle has been part of Homebrew
# itself since 4.x and tapping it now warns.
#
# Brewfile.lock.json is deliberately not committed — the lock file conflicts
# between hosts.

## Languages
# Interpreted, interactive, object-oriented programming language
brew "python@3.11"

## Tools
# Official Amazon AWS command-line interface
brew "awscli"
# Manages dotfiles across multiple machines
brew "chezmoi"
# Official CLI for interacting with Firebase
brew "firebase-cli"
# Distributed revision control system
brew "git"
# Small git utilities
brew "git-extras"
# Formatting tools for C, C++, Obj-C, Java, JavaScript, TypeScript
brew "clang-format"
# Configurable static site generator
brew "hugo"
{{ if $gui }}
## Casks
# Only installed on hosts with a GUI. A headless host renders this file without
# the section entirely rather than carrying commented-out lines.
# Terminal Emulator
cask "iterm2"
# IDE / text editor
cask "visual-studio-code"
# Web browser
cask "google-chrome"
# Password manager that keeps all passwords secure behind one password
cask "1password"
# Google Cloud CLI (renamed from google-cloud-sdk upstream)
cask "gcloud-cli"
# Knowledge base and Markdown file editor
cask "obsidian"
# Video conference software
cask "zoom"
# Voice / Text chat client
cask "discord"
{{- end }}
